<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AssistX" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>

        <!-- Android 12+ (API 31+) Native System Splash Screen Attributes -->
        <item name="android:windowSplashScreenBackground">@android:color/black</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_assistx_splash_logo</item>
        <item name="android:windowSplashScreenAnimationDuration">200</item>
    </style>
</resources>

